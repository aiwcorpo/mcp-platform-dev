# M6 layer of the images, applied by scripts/compose.sh only while M6_ACTIVE=1 (set in .env by scripts/apply-m6-switch.sh), on top of m5.env.
# Way back: scripts/apply-m6-switch.sh rollback (M6_ACTIVE=0, the instances return to the images of m5.env: mcp-gateway:m5-b2e25ae, mcp-credential-broker:m5-2110cef).
# Neither image has a database migration the M5 images lack (V7 and V6 are the last in both), so the way back needs no restore.
MCP_GATEWAY_IMAGE=mcp-gateway:m6-01c9f5a
MCP_CREDENTIAL_BROKER_IMAGE=mcp-credential-broker:m6-e538961
