# M6 stage 3 images (contracts 6.2.0), applied by scripts/compose.sh only while M6B_ACTIVE=1 (scripts/apply-m6b-switch.sh), on top of m5.env and m6.env.
# Way back: scripts/apply-m6b-switch.sh rollback (M6B_ACTIVE=0): the gateway and broker return to m6.env (m6-01c9f5a, m6-e538961), the servers and the
# portal to m5.env. Before that read "Przejscie z M5 na M6 i cofniecie" in the README of the gateway (kill switches, adapter servers).
# servicedesk is unchanged. mcp-server-adapter is used only by profile adapter (docker-compose.adapter.yml), not now.
MCP_GATEWAY_IMAGE=mcp-gateway:m6-ced1e1f
MCP_CREDENTIAL_BROKER_IMAGE=mcp-credential-broker:m6-7a48486
MCP_PORTAL_BFF_IMAGE=mcp-portal-bff:m6-434655d
MCP_PORTAL_WEB_IMAGE=mcp-portal-web:m6-434655d
MCP_JIRA_IMAGE=mcp-server-jira:m6-a3dde33
MCP_CONFLUENCE_IMAGE=mcp-server-confluence:m6-a92cc8a
MCP_GITLAB_IMAGE=mcp-server-gitlab:m6-150af6c
MCP_OPENSEARCH_IMAGE=mcp-server-opensearch:m6-508cab7
ADAPTER_IMAGE=mcp-server-adapter:m6-6e070ad
