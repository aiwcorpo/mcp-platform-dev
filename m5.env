# Overrides applied by scripts/compose.sh only while M5_ACTIVE=1 (set in .env by make m5-switch, after the M4 layer).
# Ports of the M5 services (range 18747-18759; 18747 policies, 18748/18749/18758/18759 are used by the isolated proxy and
# balancer tests): gateway instances 18752/18753, broker instances 18754/18755, balancer status pages 18750/18751.
GATEWAY_1_PORT=18752
GATEWAY_2_PORT=18753
BROKER_1_PORT=18754
BROKER_2_PORT=18755
LB_GATEWAY_STATUS_PORT=18750
LB_BROKER_STATUS_PORT=18751
PACKAGES_PORT=18756
REGISTRY_PORT=18757
MCP_TOOLS_LIST_TIMEOUT=3000
# Images of the M5 builds (contracts 5.1.0); make m5-switch refuses to run unless every one is set to a tag starting with m5- and exists locally.
MCP_GATEWAY_IMAGE=mcp-gateway:m5-cab1e08
MCP_CREDENTIAL_BROKER_IMAGE=mcp-credential-broker:m5-3f2bf19
MCP_PORTAL_BFF_IMAGE=mcp-portal-bff:m5-757a7ec
MCP_PORTAL_WEB_IMAGE=mcp-portal-web:m5-3c800fc
MCP_JIRA_IMAGE=mcp-server-jira:m5-7d196e0
MCP_CONFLUENCE_IMAGE=mcp-server-confluence:m5-f01a612
MCP_GITLAB_IMAGE=mcp-server-gitlab:m5-d145d31
MCP_SERVICEDESK_IMAGE=mcp-server-servicedesk:m5-a8b1af2
MCP_OPENSEARCH_IMAGE=mcp-server-opensearch:m5-b9173cc
