# Overrides applied by scripts/compose.sh only while M5_ACTIVE=1 (set in .env by make m5-switch, after the M4 layer).
# Ports of the M5 services (range 18747-18759; 18747 policies, 18748/18749/18758/18759 are used by the isolated proxy and
# balancer tests): gateway instances 18752/18753, broker instances 18754/18755, balancer status pages 18750/18751.
GATEWAY_1_PORT=18752
GATEWAY_2_PORT=18753
BROKER_1_PORT=18754
BROKER_2_PORT=18755
LB_GATEWAY_STATUS_PORT=18750
LB_BROKER_STATUS_PORT=18751
PACKAGES_PORT=18756
REGISTRY_PORT=18757
MCP_TOOLS_LIST_TIMEOUT=3000
# Images of the M5 builds (contracts 5.1.0) go below when ws-05 to ws-08 and the servers announce them; make m5-switch refuses to
# run until each of these is set to a tag starting with m5-. Until then the images of m4.env are in force.
#   MCP_GATEWAY_IMAGE  MCP_CREDENTIAL_BROKER_IMAGE  MCP_PORTAL_BFF_IMAGE  MCP_PORTAL_WEB_IMAGE
#   MCP_JIRA_IMAGE  MCP_CONFLUENCE_IMAGE  MCP_GITLAB_IMAGE  MCP_SERVICEDESK_IMAGE  MCP_OPENSEARCH_IMAGE
