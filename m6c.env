# M6 images on contracts 6.3.2 and starter 3.0.0-beta-14, applied by scripts/compose.sh only while M6C_ACTIVE=1 (scripts/apply-m6c-switch.sh),
# on top of m5.env, m6.env and m6b.env. m6b.env stays as it was and is the layer of the way back for the images.
# The gateway image carries migration V10 (adapter classifications UPDATE and DESTRUCTIVE become void); it cannot be undone, so the script
# has no rollback: going back to m6-ced1e1f would need a decision about the adapter rows (README of mcp-gateway, "Przejscie z M5 na M6").
# mcp-server-adapter is used only by profile adapter (docker-compose.adapter.yml), which stays off.
MCP_GATEWAY_IMAGE=mcp-gateway:m6-c18e17e
MCP_CREDENTIAL_BROKER_IMAGE=mcp-credential-broker:m6-0fdf699
MCP_PORTAL_BFF_IMAGE=mcp-portal-bff:m6-9c72041
MCP_PORTAL_WEB_IMAGE=mcp-portal-web:m6-9c72041
MCP_JIRA_IMAGE=mcp-server-jira:m6-c9bd8d8
MCP_CONFLUENCE_IMAGE=mcp-server-confluence:m6-4a87b0e
MCP_GITLAB_IMAGE=mcp-server-gitlab:m6-fb73f61
MCP_OPENSEARCH_IMAGE=mcp-server-opensearch:m6-338564b
MCP_SERVICEDESK_IMAGE=mcp-server-servicedesk:m6-b827e88
ADAPTER_IMAGE=mcp-server-adapter:m6-98b9f36
