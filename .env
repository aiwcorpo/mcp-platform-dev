# Host ports and paths only. Secrets live in .secrets/dev.env (generated, git-ignored).
COMPOSE_PROJECT_NAME=mcp-dev
MCP_CONTRACTS_DIR=../mcp-contracts

# All published ports bind to 127.0.0.1.
KEYCLOAK_PORT=18080
OPENBAO_PORT=18200
REDIS_PORT=16379
POSTGRES_PORT=15432
JIRA_MOCK_PORT=18081
BROKER_MOCK_PORT=18443
GATEWAY_ADMIN_MOCK_PORT=18444

# Ports reserved for platform components (profile "full") and their redirect URIs in the realm.
GATEWAY_PORT=18000
GATEWAY_INTERNAL_PORT=18445
MCP_JIRA_PORT=18446
BROKER_PORT=18100
PORTAL_PORT=18090
CLAUDE_CODE_CALLBACK_PORT=33418

# Images of platform components built by other streams (profile "full").
MCP_GATEWAY_IMAGE=mcp-gateway:m1-d4fbf98
MCP_CREDENTIAL_BROKER_IMAGE=mcp-credential-broker:m1-9a5d292
MCP_JIRA_IMAGE=mcp-server-jira:m1-a64287c

# Server names that clients verify on TLS (CC-035: configuration of each component, not a contract
# convention). Used as SAN in certs/ and as network aliases; after a change: make clean && make up.
MCP_BROKER_TLS_NAME=mcp-credential-broker.internal
MCP_GATEWAY_INTERNAL_TLS_NAME=mcp-gateway.internal

# mcp-contracts ref the C4/C5 stubs and audit vectors are taken from (git archive into out/contracts).
MCP_CONTRACTS_REF=v1.1.0
