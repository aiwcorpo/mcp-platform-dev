# Host ports and paths only. Secrets live in .secrets/dev.env (generated, git-ignored).
COMPOSE_PROJECT_NAME=mcp-dev
MCP_CONTRACTS_DIR=../mcp-contracts

# All published ports bind to 127.0.0.1.
KEYCLOAK_PORT=18080
# Keycloak over https (public address and `iss`): https://localhost:KEYCLOAK_TLS_PORT. KEYCLOAK_PORT stays plain http
# for scripts (admin API, make token) and the backchannel.
KEYCLOAK_TLS_PORT=18746
OPENBAO_PORT=18200
REDIS_PORT=16379
POSTGRES_PORT=15432
JIRA_MOCK_PORT=18081
GITLAB_MOCK_PORT=18741
CONFLUENCE_MOCK_PORT=18742
SERVICEDESK_MOCK_PORT=18743
OPENSEARCH_MOCK_PORT=18744
BROKER_MOCK_PORT=18443
GATEWAY_ADMIN_MOCK_PORT=18444

# Ports reserved for platform components (profile "full") and their redirect URIs in the realm.
GATEWAY_PORT=18000
GATEWAY_INTERNAL_PORT=18445
MCP_JIRA_PORT=18446
BROKER_PORT=18100
PORTAL_PORT=18090
# Single public origin of portal and gateway (profile full): https://localhost:PROXY_TLS_PORT (browsers, MCP
# clients). PROXY_PORT is the same proxy over plain http, for tools without TLS (make m1 health checks).
PROXY_PORT=18740
PROXY_TLS_PORT=18745
CLAUDE_CODE_CALLBACK_PORT=33418

# Images of platform components built by other streams (profile "full").
MCP_GATEWAY_IMAGE=mcp-gateway:m2-d65088f
MCP_CREDENTIAL_BROKER_IMAGE=mcp-credential-broker:m2-bcfec7a
MCP_JIRA_IMAGE=mcp-server-jira:m1-7ec295e

# Server names that clients verify on TLS (CC-035: configuration of each component, not a contract
# convention). Used as SAN in certs/ and as network aliases; after a change: make clean && make up.
MCP_BROKER_TLS_NAME=mcp-credential-broker.internal
MCP_GATEWAY_INTERNAL_TLS_NAME=mcp-gateway.internal

# mcp-contracts ref the C4/C5 stubs and audit vectors are taken from (git archive into out/contracts).
MCP_CONTRACTS_REF=v1.1.0

# Images of profile "m2" (scripts/build-images-m2.sh prints these lines).
MCP_PORTAL_BFF_IMAGE=mcp-portal-bff:m2-93f0e9f
MCP_PORTAL_WEB_IMAGE=mcp-portal-web:m2-2134a8e
MCP_CONFLUENCE_IMAGE=mcp-server-confluence:m2-ae9fe3a
MCP_GITLAB_IMAGE=mcp-server-gitlab:m2-9ef55d3
MCP_SERVICEDESK_IMAGE=mcp-server-servicedesk:m2-63e56cb
MCP_OPENSEARCH_IMAGE=mcp-server-opensearch:m2-7619dd4
