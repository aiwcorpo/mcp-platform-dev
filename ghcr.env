# Source "ghcr" (MCP_IMAGE_SOURCE=ghcr in .env, make use-ghcr): the released 1.0.0 images, no sibling checkouts, no local build.
# scripts/compose.sh passes this file last, so it wins over m4.env ... m6c.env (the layers stay on; only their image tags are replaced).
# Public images, anonymous pull. mcp-server-adapter 1.0.0 was not pullable on 2026-11-05 (403); only profile adapter uses it.
MCP_GATEWAY_IMAGE=ghcr.io/aiwcorpo/mcp-gateway:1.0.0
MCP_CREDENTIAL_BROKER_IMAGE=ghcr.io/aiwcorpo/mcp-credential-broker:1.0.0
MCP_PORTAL_BFF_IMAGE=ghcr.io/aiwcorpo/mcp-portal-bff:1.0.0
MCP_PORTAL_WEB_IMAGE=ghcr.io/aiwcorpo/mcp-portal-web:1.0.0
MCP_JIRA_IMAGE=ghcr.io/aiwcorpo/mcp-server-jira:1.0.0
MCP_CONFLUENCE_IMAGE=ghcr.io/aiwcorpo/mcp-server-confluence:1.0.0
MCP_GITLAB_IMAGE=ghcr.io/aiwcorpo/mcp-server-gitlab:1.0.0
MCP_OPENSEARCH_IMAGE=ghcr.io/aiwcorpo/mcp-server-opensearch:1.0.0
MCP_SERVICEDESK_IMAGE=ghcr.io/aiwcorpo/mcp-server-servicedesk:1.0.0
ADAPTER_IMAGE=ghcr.io/aiwcorpo/mcp-server-adapter:1.0.0

# Dev policy bundles signed with the dev- key of the policies repo (policies-dev/, refreshed by scripts/policies-snapshot.sh): no JDK 25
# and no ../mcp-policies needed. The dev- key ids are accepted only by components in dev mode (MCP_POLICY_ALLOW_TEST_KEYS).
POLICY_REPOSITORY_DIR=./policies-dev/repository
POLICY_KEYS_DIR=./policies-dev/keys
POLICY_KEY_MAIN_ID=dev-policies-main
POLICY_KEY_OVERRIDES_ID=dev-policies-overrides

# Copy of mcp-portal/bff/dev/iga-mock.yaml (the only file the BFF reads from it).
PORTAL_DEV_DATA_DIR=./portal-dev-data

# Release of the MCP servers whose mcp-manifest.json is taken from the GitHub Release (scripts/fetch-manifests.sh), and the
# @aiwcorpo/mcp-contracts version on npm the C4/C5 stand-ins and audit vectors are taken from (scripts/fetch-contracts.sh).
MCP_RELEASE_TAG=v1.0.0
MCP_CONTRACTS_NPM_VERSION=6.3.2
