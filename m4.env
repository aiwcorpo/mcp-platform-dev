MCP_PORTAL_WEB_IMAGE=mcp-portal-web:m4-58c0b7b
MCP_JIRA_IMAGE=mcp-server-jira:m4-7f3f951
MCP_CONFLUENCE_IMAGE=mcp-server-confluence:m4-bb3289e
MCP_GITLAB_IMAGE=mcp-server-gitlab:m4-516853a
MCP_SERVICEDESK_IMAGE=mcp-server-servicedesk:m4-f248714
MCP_OPENSEARCH_IMAGE=mcp-server-opensearch:m4-1862fb4
POLICY_KEY_MAIN_ID=dev-policies-main
POLICY_KEY_OVERRIDES_ID=dev-policies-overrides
