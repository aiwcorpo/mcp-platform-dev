# Overrides applied by scripts/compose.sh only while M4_ACTIVE=1 (set in .env by make m4-switch); until then the file is ignored and
# the stack keeps its M3 configuration. Images of other components are added here when their M4 builds are announced.
MCP_CREDENTIAL_BROKER_IMAGE=mcp-credential-broker:m4-9fb07d2
POLICY_KEY_MAIN_ID=dev-policies-main
POLICY_KEY_OVERRIDES_ID=dev-policies-overrides
